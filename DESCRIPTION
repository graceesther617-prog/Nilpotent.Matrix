Package: Nilpotent.Matrix
Type: Package
Title: Absorbing Markov Chains and Nilpotent Matrix Diagnostics for Predictive maintenance
Version: 0.1.0
Authors@R: c(
    person(
    "Esther Grâce Divine", "NGO LISSOUCK",
      email = "graceesther617@gmail.com",
      role = c("aut", "cre")
    )
